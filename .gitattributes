# The distributable plugin is the folio-drawbridge/ subdirectory, and
# bin/build-release.sh archives that subtree directly. Everything at the
# repository root — wordpress.org assets, tooling, developer documentation — is
# therefore outside the package by construction, with no export-ignore needed.
#
# This layout matches Folio Gatehouse, which is already published.
#
# Entries below apply within the shipped subtree only.

.gitattributes   export-ignore
